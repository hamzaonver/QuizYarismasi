@model List<SessionListDto>
@{
    ViewData["Title"] = "Oturumlarım";
}

<h1 class="page-title">Oturumlarım</h1>
<p class="page-subtitle">Açtığın canlı oturumlar. Yeni oturum açmak için yayındaki bir quizin sayfasında "Canlı oturum başlat"a bas.</p>

@if (Model.Count == 0)
{
    <div class="qa-card empty-state">
        <h2 class="h5 fw-bold">Henüz oturum açmadın</h2>
        <p>Bir quizi yayınla, sonra quiz sayfasından canlı oturum başlat.</p>
        <a class="btn btn-primary" asp-controller="Quiz" asp-action="Index">Quizlerime git</a>
    </div>
}
else
{
    <div class="qa-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Quiz</th>
                        <th>Katılım kodu</th>
                        <th>Durum</th>
                        <th>Katılımcı</th>
                        <th>Tarih</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold">@s.QuizTitle</td>
                            <td><code class="fs-6">@s.JoinCode</code></td>
                            <td><partial name="_SessionStatusBadge" model="s.Status" /></td>
                            <td>@s.ParticipantCount</td>
                            <td class="text-muted small">@s.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Host" asp-route-id="@s.Id">Aç</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
