@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Hoş geldiniz";
}

<section class="hero mb-4">
    <h1>Sınıfta yarışarak öğren.</h1>
    <p class="mt-3">Öğretmen quizini hazırlar, öğrenciler katılım koduyla bağlanır; hızlı ve doğru cevaplayan lider tablosunda yükselir.</p>
    <div class="d-flex flex-wrap gap-2 mt-4">
        <a class="btn btn-light btn-lg fw-bold" asp-controller="Account" asp-action="Register">Hemen kayıt ol</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Giriş yap</a>
    </div>
    <div class="hero-shapes" aria-hidden="true">
        <span class="opt-1"></span><span class="opt-2"></span>
        <span class="opt-3"></span><span class="opt-4"></span>
    </div>
</section>

@if (Env.IsDevelopment())
{
    @* Hafta 8 (vize demosu): linke giren hocanın siteyi nasıl deneyeceğini gösteren kısa rehber *@
    <div class="qa-card mb-4">
        <h2 class="h5 fw-bold mb-3">Nasıl denenir? (vize demosu · v@(QuizArena.Web.AppInfo.Version))</h2>
        <ol class="mb-0">
            <li><strong>Öğretmen:</strong> Kayıt ol (rol: Öğretmen, davet kodu aşağıda) ya da demo öğretmen hesabıyla giriş yap.</li>
            <li><strong>Quiz hazırla:</strong> + Yeni quiz → soru ekle (2–6 şık, tek doğru cevap) → <em>Yayınla</em>.</li>
            <li><strong>Canlı oturum:</strong> Quiz sayfasında <em>▶ Canlı oturum başlat</em> → ekranda 6 haneli katılım kodu çıkar.</li>
            <li><strong>Öğrenci:</strong> Başka bir cihazdan (telefon) ya da gizli pencereden öğrenci olarak kayıt ol/giriş yap → kodu ve takma adı gir.</li>
            <li><strong>Yönet:</strong> Öğretmen ekranında katılımcılar 3 saniye içinde görünür → <em>Oturumu başlat</em> → <em>Sonraki soru</em> → bitir.</li>
        </ol>
        <partial name="_DemoBilgi" />
    </div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="qa-card feature h-100">
            <h3>Quiz oluştur</h3>
            <p>Soruları, şıkları, doğru cevabı ve süreyi belirle. Taslak olarak sakla, hazır olunca yayınla.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="qa-card feature h-100">
            <h3>Canlı oturum</h3>
            <p>Katılım koduyla sınıf aynı anda bağlanır; öğretmen soruları yönetir, öğrencinin ekranı soruyu takip eder.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="qa-card feature h-100">
            <h3>Lider tablosu ve analiz</h3>
            <p>Süre bonuslu puanlama, güç kartları ve oturum sonu soru zorluk analizi. <span class="badge badge-draft">Yakında</span></p>
        </div>
    </div>
</div>
